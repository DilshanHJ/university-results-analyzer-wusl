{
  "name": "university-results-analyzer",
  "version": "2.0.0",
  "private": true,
  "description": "Production-grade academic results management and analytics platform",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @results/api --filter @results/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @results/api db:generate",
    "db:migrate": "pnpm --filter @results/api db:migrate",
    "db:seed": "pnpm --filter @results/api db:seed",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down"
  }
}
